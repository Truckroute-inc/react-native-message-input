    "message-composer",
    "autocorrect",
    "autocorrection",
    "keyboard",
    "text-input",
    "uitextfield",
    "typescript"
  ],
  "author": "Truckroute inc",
  "homepage": "https://github.com/Truckroute-inc/react-native-message-input#readme",
  "bugs": {
    "url": "https://github.com/Truckroute-inc/react-native-message-input/issues"
