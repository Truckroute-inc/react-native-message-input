{
  "name": "@truckroute/message-input",
  "version": "0.1.0",
  "description": "React Native message input that commits iOS keyboard autocorrection before submission and clears the field in one native operation.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "ios",
    "expo-module.config.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Truckroute-inc/react-native-message-input.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "tsc --noEmit && prettier --check . && vitest run",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "expo": ">=52",
    "react": ">=18.3.1",
    "react-native": ">=0.76"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "expo": "~57.0.24",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "typescript": "~6.0.3",
    "vitest": "4.0.18"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-module",
    "ios",
    "android",
